rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == "hU0pqkyVYMYhBQ5GBAPHcHemph23"
        && request.auth.token.email == "afterdark706@gmail.com";
    }

    // Each team can read its own profile and create only a team profile.
    // Only the owner can inspect or manage all user profiles.
    match /users/{userId} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow list: if isOwner();
      allow create: if isOwner() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "team"
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(["fullName", "email", "role", "createdAt"])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 1
      );
      allow update, delete: if isOwner();
    }

    // Public directory exposes team names only, never emails or account details.
    match /teamDirectory/{teamId} {
      allow read: if true;
      allow create: if isOwner() || (signedIn()
        && request.auth.uid == teamId
        && request.resource.data.keys().hasOnly(["fullName","updatedAt"])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 1);
      allow update, delete: if isOwner();
    }

    // Publicly readable site content; only the owner can publish or edit it.
    match /news/{document=**} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /results/{document=**} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Booking requests are created by authenticated team accounts.
    match /bookings/{bookingId} {
      function isTeam() {
        return signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "team";
      }
      allow create: if isOwner() || (isTeam()
        && request.resource.data.teamUid == request.auth.uid
        && request.resource.data.teamEmail == request.auth.token.email
        && request.resource.data.teamName is string
        && request.resource.data.opponentName is string
        && request.resource.data.day is string
        && request.resource.data.time is string
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "teamUid", "teamEmail", "teamName", "opponentName",
          "day", "time", "note", "status", "createdAt"
        ]));
      // Homepage may LIST only approved bookings; pending/rejected requests stay private.
      // The owner can list every booking, and each team can read its own booking.
      allow get: if isOwner() || resource.data.status == "approved" || (signedIn() && resource.data.teamUid == request.auth.uid);
      allow list: if isOwner() || resource.data.status == "approved";
      allow update, delete: if isOwner();
    }

    // Team challenges: public teams can see open challenges, while each
    // participant can also see the challenges they created or accepted.
    match /challenges/{challengeId} {
      function isTeam() {
        return signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "team";
      }
      allow read: if isOwner() || (signedIn() && (
        resource.data.status == "open"
        || resource.data.teamUid == request.auth.uid
        || resource.data.acceptedByUid == request.auth.uid
      ));
      allow create: if isTeam()
        && request.resource.data.teamUid == request.auth.uid
        && request.resource.data.teamName is string
        && request.resource.data.day is string
        && request.resource.data.time is string
        && request.resource.data.note is string
        && request.resource.data.status == "open"
        && request.resource.data.keys().hasOnly([
          "teamUid", "teamName", "day", "time", "note", "status", "createdAt"
        ]);
      allow update: if isOwner() || (
        isTeam()
        && resource.data.status == "open"
        && resource.data.teamUid != request.auth.uid
        && request.resource.data.status == "accepted"
        && request.resource.data.acceptedByUid == request.auth.uid
        && request.resource.data.acceptedByName is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "acceptedByUid", "acceptedByName", "acceptedAt"
        ])
      );
      allow delete: if isOwner() || (
        isTeam() && resource.data.teamUid == request.auth.uid
      );
    }


    // Private messages are available only after a challenge is accepted.
    // The two participating teams and the stadium owner can read and send messages.
    match /challenges/{challengeId}/messages/{messageId} {
      function canAccessChallengeChat() {
        return isOwner() || (signedIn()
          && get(/databases/$(database)/documents/challenges/$(challengeId)).data.status == "accepted"
          && (
            get(/databases/$(database)/documents/challenges/$(challengeId)).data.teamUid == request.auth.uid
            || get(/databases/$(database)/documents/challenges/$(challengeId)).data.acceptedByUid == request.auth.uid
          ));
      }
      allow read: if canAccessChallengeChat();
      allow create: if canAccessChallengeChat()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(["senderUid","senderName","text","createdAt"]);
      allow update, delete: if false;
    }

    // Public append-only leaderboards for the two lightweight stadium games.
    match /gameScores/{game}/entries/{entryId} {
      allow read: if game in ["penalty", "crossbar", "players"];
      allow create: if game in ["penalty", "players"]
        && request.resource.data.keys().hasOnly(["name", "score", "shots", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 24
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000
        && request.resource.data.createdAt is timestamp
        && (game != "penalty" || (request.resource.data.shots is int && request.resource.data.shots >= request.resource.data.score));
      allow update, delete: if false;
    }

    // Everything else remains closed until its data model and permissions
    // are implemented deliberately.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}